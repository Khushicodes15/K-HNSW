{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Khushicodes15/K-HNSW/docs/contracts/schemas/events/search.schema.json",
  "title": "search Event Schema",
  "type": "object",
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string" },
    "seq": { "type": "integer", "minimum": 0 },
    "t": { "type": "number", "minimum": 0.0 },
    "type": { "type": "string", "const": "search" },
    "node": { "type": ["integer", "null"] },
    "level": { "type": "null" },
    "version": { "type": "null" },
    "payload": {
      "type": "object",
      "properties": {
        "k": { "type": "integer", "minimum": 1 },
        "ef": { "type": "integer", "minimum": 1 },
        "latency_ms": { "type": "number", "minimum": 0.0 },
        "distance_computations": { "type": "integer", "minimum": 0 },
        "example": { "type": "boolean" }
      },
      "required": ["k", "ef"]
    }
  },
  "required": ["schema_version", "run_id", "seq", "t", "type", "node", "level", "version", "payload"]
}
